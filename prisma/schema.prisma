generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ModuleKey {
  POS
  KITCHEN
  PRODUCTS
  CUSTOMERS
  HR
  ROOMS
  STORE
  BAR_LOUNGE
  HOUSEKEEPING
  RESERVATIONS
  ACCOUNTING
  REPORTS
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
  BARISTA
  STORE_KEEPER
  RECEPTIONIST
  HOUSEKEEPER
}

enum DrinkTemperature {
  HOT
  COLD
  OTHER
}

enum RoomStatus {
  VACANT
  OCCUPIED
  OUT_OF_SERVICE
}

enum ReservationStatus {
  BOOKED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum RoomCleanliness {
  CLEAN
  DIRTY
  INSPECTING
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum HousekeepingTaskType {
  CLEANING
  INSPECTION
  MAINTENANCE
}

enum InventoryMovementType {
  RECEIPT
  DISPATCH
  ADJUSTMENT
}

enum PosOrderStatus {
  OPEN
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  tenantModules TenantModule[]
  cafeSettings  CafeSettings?
  stores        Store[]
  inventoryItems InventoryItem[]
  inventoryMovements InventoryMovement[]
  posOrders      PosOrder[]
  addons         Addon[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  customers      Customer[]
  rooms          Room[]
  roomTypes      RoomType[]
  reservations   Reservation[]
  housekeepingTasks HousekeepingTask[]
}

model Customer {
  id           String        @id @default(cuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([tenantId, lastName, firstName])
}

model Room {
  id           String        @id @default(cuid())
  tenantId     String
  number       String
  name         String?
  type         String
  capacity     Int           @default(2)
  nightlyRate  Decimal       @db.Decimal(12, 2)
  status       RoomStatus    @default(VACANT)
  cleanliness  RoomCleanliness @default(CLEAN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  housekeepingTasks HousekeepingTask[]

  @@unique([tenantId, number])
}

model RoomType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  capacity    Int      @default(2)
  baseRate    Decimal  @db.Decimal(12, 2)
  amenities   String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model HousekeepingTask {
  id          String                 @id @default(cuid())
  tenantId    String
  roomId      String
  type        HousekeepingTaskType   @default(CLEANING)
  status      HousekeepingTaskStatus @default(PENDING)
  assignedTo  String?
  notes       String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room        Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, roomId])
}

model Reservation {
  id          String            @id @default(cuid())
  tenantId    String
  customerId  String
  roomId      String
  checkIn     DateTime
  checkOut    DateTime
  adults      Int               @default(1)
  children    Int               @default(0)
  status      ReservationStatus @default(BOOKED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  room        Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  posOrders   PosOrder[]

  @@index([tenantId, checkIn, checkOut])
  @@index([tenantId, roomId, status])
}

model CafeSettings {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  cafeName         String
  currency         String   @default("KES")
  inventoryEnabled Boolean  @default(true)
  lowStockAlerts   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Store {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  code      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     InventoryItem[]
  movements InventoryMovement[]

  @@unique([tenantId, code])
}

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  storeId      String
  name         String
  sku          String
  unit         String   @default("each")
  quantity     Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel Decimal  @default(0) @db.Decimal(12, 3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  menuItems    MenuItem[]
  movements    InventoryMovement[]
  menuIngredients MenuItemIngredient[]

  @@unique([tenantId, sku])
  @@index([tenantId, storeId])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  tenantId        String
  inventoryItemId String
  storeId         String
  type            InventoryMovementType
  quantity        Decimal               @db.Decimal(12, 3)
  note            String?
  performedBy     String?
  occurredAt      DateTime              @default(now())
  createdAt       DateTime              @default(now())
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([tenantId, inventoryItemId, occurredAt])
  @@index([tenantId, storeId, occurredAt])
}

model MenuCategory {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  @@unique([tenantId, name])
}

model MenuItem {
  id              String           @id @default(cuid())
  tenantId        String
  categoryId      String
  inventoryItemId String?
  name            String
  description     String?
  price           Decimal          @db.Decimal(12, 2)
  temperature     DrinkTemperature @default(OTHER)
  isAvailable     Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        MenuCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryItem   InventoryItem?   @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  ingredients     MenuItemIngredient[]
  orderItems      PosOrderItem[]

  @@index([tenantId, categoryId])
}

model PosOrder {
  id          String         @id @default(cuid())
  tenantId    String
  reservationId String?
  orderNumber Int
  tableLabel  String?
  status      PosOrderStatus @default(OPEN)
  notes       String?
  readyAt     DateTime?
  servedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  items       PosOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt])
  @@index([reservationId])
}

model PosOrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  order      PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  addons     PosOrderItemAddon[]

  @@index([orderId])
}

model Addon {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems PosOrderItemAddon[]

  @@unique([tenantId, name])
}

model PosOrderItemAddon {
  id          String       @id @default(cuid())
  orderItemId String
  addonId     String
  quantity    Int          @default(1)
  unitPrice   Decimal      @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  orderItem   PosOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon       Addon        @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
}

model MenuItemIngredient {
  id              String        @id @default(cuid())
  menuItemId      String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(12, 3)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, inventoryItemId])
  @@index([inventoryItemId])
}

model Module {
  key           ModuleKey      @id
  name          String
  description   String?
  tenantModules TenantModule[]
}

model TenantModule {
  id        String    @id @default(cuid())
  tenantId  String
  moduleKey ModuleKey
  isEnabled Boolean   @default(true)
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    Module    @relation(fields: [moduleKey], references: [key])

  @@unique([tenantId, moduleKey])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  password  String
  firstName String
  lastName  String
  role      UserRole @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}
