DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotelier?schema=public"
PORT=4000
NODE_ENV=development
# Comma-separated — one origin per local dev server (REACT, the platform
# admin app, ...). In production these are unnecessary: APP_DOMAIN's
# wildcard already covers every subdomain, tenant or platform alike.
CORS_ORIGIN="http://localhost:5173,http://localhost:5175"
# Production only: root domain tenants (and the platform admin app) are
# served under, e.g. "tanzhotelier.app". Requests from any
# <anything>.tanzhotelier.app are allowed in addition to CORS_ORIGIN.
# APP_DOMAIN=tanzhotelier.app
# First platform admin account for the standalone platform admin app.
# Consumed ONLY by `npm run seed:platform-admin` — the running app never
# reads these. After seeding, admins sign in with email + password and more
# accounts are managed as PlatformAdmin rows.
PLATFORM_ADMIN_EMAIL=admin@tanz.co
PLATFORM_ADMIN_PASSWORD=changeme123
PLATFORM_ADMIN_NAME="TANZ Admin"
